  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- LibRunner only needs src for CryptoApi.h/CryptoApiTester.h's declarations; the actual
           implementation comes from linking CryptoAPI_static.lib below, not from compiling any
           SDK source directly. -->
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- CryptoAPI_static.lib is built with the static CRT (MultiThreadedDebug/MultiThreaded), same
       reasoning as AppBuilder/DllBuilder/LibBuilder; everything that ends up in one binary must
       agree on the CRT. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- CryptoAPI_static.lib itself has no link step of its own (see LibBuilder.vcxproj's own
       comment), so LibRunner, the first thing that actually LINKS it into an executable, is
       responsible for supplying every one of its transitive dependencies here: cryptlib.lib
       (Crypto++), libcrypto.lib (OpenSSL), libgcrypt-20-msvc.lib (x64 only), and the system libs
       OpenSSL's own NOTES-WINDOWS.md requires for static linking. -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\cryptopp890\$(Platform)\Output\$(Configuration);$(ProjectDir)..\..\..\3rdParty\openssl402\_libs\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>cryptlib.lib;libcrypto.lib;ws2_32.lib;gdi32.lib;advapi32.lib;crypt32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Same LNK4099 (missing OpenSSL PDB) silencing as AppBuilder/DllBuilder. -->
      <AdditionalOptions>/ignore:4099 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Build-ordering only (same as AppBuilder.vcxproj's identical references): ensures
         cryptlib.lib exists before LibRunner links it in via AdditionalDependencies above. Not
         relied upon for auto-linking, unlike AppBuilder's own reference to this project, since
         LibRunner needs an explicit AdditionalDependencies entry anyway (there is no single
         "the" library this executable links; it must combine CryptoAPI_static.lib with all of
         its transitive dependencies itself). -->
    <ProjectReference Include="..\..\..\3rdParty\cryptopp890\cryptlib.vcxproj">
      <Project>{c39f4b46-6e89-4074-902e-ca57073044d2}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\..\..\3rdParty\openssl402\openssl.vcxproj">
      <Project>{5e6a1e2d-8c3f-4d4a-9b1e-2f7a6c9d0e11}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <!-- Build-ordering only: ensures CryptoAPI_static.lib exists before LibRunner links it in via
         the platform-conditioned AdditionalLibraryDirectories/AdditionalDependencies below. -->
    <ProjectReference Include="..\LibBuilder\LibBuilder.vcxproj">
      <Project>{49eaea3c-a090-407b-83a9-b1f41b18d709}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libgcrypt-20-msvc.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Copying the libgcrypt runtime DLLs next to the output executable</Message>
      <Command>xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgcrypt-20.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgpg-error-0.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <!-- CryptoAPI_static.lib itself is linked via #pragma comment(lib, "CryptoAPI_static.lib") in
       Main.cpp rather than an AdditionalDependencies entry here, but the linker still needs a
       search path to resolve that name, hence these AdditionalLibraryDirectories entries.
       LibBuilder.vcxproj's own output directory differs by platform (MSBuild's default OutDir is
       "$(Configuration)\" for Win32 but "$(Platform)\$(Configuration)\" for x64), so, unlike the
       single cryptlib/openssl paths above, this needs its own per-platform condition. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\LibBuilder\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\LibBuilder\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
