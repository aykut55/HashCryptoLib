  <!-- Keep Visual Studio Run/F5 consistent with direct execution from the build output folder,
       where LibRunner.exe and its copied runtime dependencies are located. -->
  <PropertyGroup>
    <LocalDebuggerCommand>$(TargetPath)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ForceSynchronousPDBWrites>true</ForceSynchronousPDBWrites>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- LibRunner only needs src for CryptoApi.h/CryptoApiTester.h's declarations; the actual
           CCryptoApi/CPgpEngine/CPgpEngineWrapper implementation comes from linking
           CryptoAPI_static.lib below, not from compiling any provider SDK source directly.
           LibRunner DOES compile the 5 scripting engines (CLuaScriptEngineSol/LuaBridge/
           LuaBridgeLegacy/CChaiScriptEngine/CPythonScriptEngine) plus BOTH script facade families:
           CScriptCryptoApi/CScriptPgpEngine/CScriptPgpEngineWrapper (the LOCAL, CCryptoApi-owning
           ones, since LibRunner has no DLL boundary and no DLL_RUNNER macro, same as AppBuilder)
           AND CScriptCryptoApiDll/CScriptPgpEngineDll/CScriptPgpEngineWrapperDll (needed only
           because each engine's own registerBindings() references those types unconditionally,
           not gated by #ifndef DLL_RUNNER; same reason AppBuilder.vcxproj compiles both families
           too, even though AppBuilder never constructs a *Dll instance either). See DllRunner.vcxproj's
           own near-identical comment for the DLL-hosted counterpart of this same scripting wiring. -->
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Lua (3rdParty\scripts\lua547, built by Lua547.vcxproj) and sol2 (3rdParty\scripts\sol330,
       header-only): the Lua scripting engine's binding library. Same dedicated-block precedent
       AppBuilder.vcxproj/DllRunner.vcxproj's own identical comment documents. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\lua547\src;$(ProjectDir)..\..\..\3rdParty\scripts\sol330;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- ChaiScript (3rdParty\scripts\chaiscript610\include, header-only). LuaBridge3/LuaBridge 2.10's
       own include paths are NOT added here (both publish "LuaBridge/LuaBridge.h" at the same
       relative path); each gets its override on its own ClCompile item below instead. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\chaiscript610\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- CryptoAPI_static.lib is built with the static CRT (MultiThreadedDebug/MultiThreaded), same
       reasoning as AppBuilder/DllBuilder/LibBuilder; everything that ends up in one binary must
       agree on the CRT. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- CryptoAPI_static.lib itself has no link step of its own (see LibBuilder.vcxproj's own
       comment), so LibRunner, the first thing that actually LINKS it into an executable, is
       responsible for supplying every one of its transitive dependencies here: cryptlib.lib
       (Crypto++), libcrypto.lib (OpenSSL), libgcrypt-20-msvc.lib (x64 only), and the system libs
       OpenSSL's own NOTES-WINDOWS.md requires for static linking. -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\cryptopp890\$(Platform)\Output\$(Configuration);$(ProjectDir)..\..\..\3rdParty\openssl402\_libs\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>cryptlib.lib;libcrypto.lib;Lua547.lib;ws2_32.lib;gdi32.lib;advapi32.lib;crypt32.lib;user32.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Same LNK4099 (missing OpenSSL PDB) silencing as AppBuilder/DllBuilder. -->
      <AdditionalOptions>/ignore:4099 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Build-ordering only (same as AppBuilder.vcxproj's identical references): ensures
         cryptlib.lib exists before LibRunner links it in via AdditionalDependencies above. Not
         relied upon for auto-linking, unlike AppBuilder's own reference to this project, since
         LibRunner needs an explicit AdditionalDependencies entry anyway (there is no single
         "the" library this executable links; it must combine CryptoAPI_static.lib with all of
         its transitive dependencies itself). -->
    <ProjectReference Include="..\..\..\3rdParty\cryptopp890\cryptlib.vcxproj">
      <Project>{c39f4b46-6e89-4074-902e-ca57073044d2}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\..\..\3rdParty\openssl402\openssl.vcxproj">
      <Project>{5e6a1e2d-8c3f-4d4a-9b1e-2f7a6c9d0e11}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <!-- Build-ordering only: ensures CryptoAPI_static.lib exists before LibRunner links it in via
         the platform-conditioned AdditionalLibraryDirectories/AdditionalDependencies below. -->
    <ProjectReference Include="..\LibBuilder\LibBuilder.vcxproj">
      <Project>{49eaea3c-a090-407b-83a9-b1f41b18d709}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <!-- Build-ordering + explicit AdditionalDependencies entry (Lua547.lib above), same
         LinkLibraryDependencies=false style as this project's other references (LibRunner never
         relies on ProjectReference auto-linking, unlike AppBuilder/DllRunner's own reference to
         this same project). -->
    <ProjectReference Include="..\..\..\3rdParty\scripts\lua547\Lua547.vcxproj">
      <Project>{7f3e9a2c-4b1d-4e6a-9c8f-2d5b6a7e1f30}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\lib;$(ProjectDir)..\..\..\3rdParty\scripts\python312\libs;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- CPythonScriptEngine (see PythonScriptEngine.h/.cpp) embeds CPython via pybind11; x64
           ONLY, same precedent as AppBuilder.vcxproj/DllRunner.vcxproj's own identical block. -->
      <AdditionalDependencies>libgcrypt-20-msvc.lib;python312.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- PostBuildEvent's <Command> is a single project property, not batched %()-style item
         metadata (same gotcha AppBuilder.vcxproj's own identical comment documents): the Python
         runtime copy is appended into this SAME Command rather than a second PostBuildEvent, which
         would silently overwrite this one instead of appending. -->
    <PostBuildEvent>
      <Message>Copying the libgcrypt and Python runtime DLLs/stdlib next to the output executable</Message>
      <Command>xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgcrypt-20.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgpg-error-0.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\*.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\*.pyd" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\python312.zip" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <!-- CryptoAPI_static.lib itself is linked via #pragma comment(lib, "CryptoAPI_static.lib") in
       Main.cpp rather than an AdditionalDependencies entry here, but the linker still needs a
       search path to resolve that name, hence these AdditionalLibraryDirectories entries.
       $(SolutionDir)$(Platform)\$(Configuration)\ (x64) / $(SolutionDir)$(Configuration)\ (Win32)
       is where every project in All.sln actually lands its output (MSBuild's default OutDir when
       none of these vcxproj overrides it, which none do), NOT a path relative to LibBuilder's own
       ProjectDir. A stale $(ProjectDir)..\LibBuilder\... variant of this comment/path used to sit
       here, pointing at a per-project output folder nothing else in the solution writes to; it
       silently resolved to a real but STALE CryptoAPI_static.lib left over in that folder from a
       build that predates this repo's later changes, which the linker preferred over the freshly
       built one in $(SolutionDir)$(Platform)\$(Configuration)\, only surfaced once a symbol's own
       mangled name changed (CPgpEngine::GenerateKeyPair becoming virtual, deriving from
       IPgpEngine, 2026-09-21) and the stale copy no longer had a matching one (LNK2019). -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <Link>
      <AdditionalLibraryDirectories>$(SolutionDir)$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalLibraryDirectories>$(SolutionDir)$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
