  <!-- Renames the project-named ($(TargetName).lib) build output to the product-named
       (CryptoAPI_static.lib) file (via rename_output.bat's copy-then-delete "DELETE" mode). A
       static library has no separate import lib/DLL/PDB naming to fix up, unlike
       DllBuilder.vcxproj, so this is the library's only post-build step. -->
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Message>Renaming the project-named ($(TargetName).lib) build output to the product-named (CryptoAPI_static.lib) file</Message>
      <Command>call "$(ProjectDir)..\..\..\src\scripts\batch\rename_output.bat" "$(OutDir)" "$(TargetName)" "CryptoAPI_static" "DELETE"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\src;$(ProjectDir)..\..\..\3rdParty;$(ProjectDir)..\..\..\3rdParty\botan3130\$(Platform);$(ProjectDir)..\..\..\3rdParty\openssl402\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Botan's amalgamation headers require C++20 (std::span, concepts, etc.). -->
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- A static library has no link step of its own (the librarian just archives object files;
       no symbol resolution against cryptlib.lib/libcrypto.lib/libgcrypt-20-msvc.lib happens here),
       so unlike AppBuilder.vcxproj/DllBuilder.vcxproj this project needs no AdditionalDependencies,
       AdditionalLibraryDirectories, or ProjectReference to those 3rdParty libs; only their headers,
       via AdditionalIncludeDirectories, to compile. Whatever eventually links CryptoAPI_static.lib
       into an executable (the future LibRunner) supplies cryptlib.lib/libcrypto.lib/
       libgcrypt-20-msvc.lib itself, matching the RuntimeLibrary setting below. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- libgcrypt (CLibgcryptProvider, PROVIDER_LIBGCRYPT) is x64 ONLY; see AppBuilder.vcxproj's
       identical block for the full rationale. Only the include path is needed here to compile
       LibgcryptProvider.cpp; no lib/DLL is linked or copied by a static-library build. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
