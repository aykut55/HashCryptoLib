      <RenamedOutputsToClean Include="$(OutDir)CryptoAPI_static.lib;$(OutDir)CryptoAPI_static.pdb" />
    </ItemGroup>
    <Delete Files="@(RenamedOutputsToClean)" TreatErrorsAsWarnings="true" />
  </Target>
