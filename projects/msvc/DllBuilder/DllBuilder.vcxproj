  <!-- cryptlib.lib is built with the static CRT (MultiThreadedDebug/MultiThreaded); match it here
       so the whole project links against the same CRT as the Crypto++ provider's dependency (same
       reasoning as AppBuilder.vcxproj). -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
