    </ClCompile>
  </ItemDefinitionGroup>
  <!-- OpenSSL's libcrypto.lib is built per-Platform/Configuration under openssl402\_libs (see
       openssl402\openssl.vcxproj and its build-scripts); enable-static-vcruntime was used when
       building it so its CRT matches ours. Static linking also needs these system libs per
       OpenSSL's NOTES-WINDOWS.md. -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\openssl402\_libs\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libcrypto.lib;ws2_32.lib;gdi32.lib;advapi32.lib;crypt32.lib;user32.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- libcrypto.lib's PDB (ossl_static.pdb) isn't archived alongside it, so the linker warns
           LNK4099 for every OpenSSL object; harmless (no debug info for OpenSSL internals), so
           silence it rather than leave noise in the build log. -->
      <AdditionalOptions>/ignore:4099 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!-- libgcrypt (CLibgcryptProvider, PROVIDER_LIBGCRYPT) is x64 ONLY; see AppBuilder.vcxproj's
       identical block for the full rationale (vendored MSVC-native import lib, no Win32 build
       exists, LibgcryptProvider.cpp compiles to an all-unsupported stub on Win32 via its
       ARCH_X64/ARCH_WIN64 guard). libgpg-error-0.dll is copied next to the DLL only because it's a
       runtime dependency of libgcrypt-20.dll itself, not because this project links against it. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libgcrypt-20-msvc.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Copying the libgcrypt runtime DLLs next to the output DLL, then renaming the project-named ($(TargetName).*) build output to the product-named (CryptoAPI.*) files</Message>
      <Command>xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgcrypt-20.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgpg-error-0.dll" "$(OutDir)"
call "$(ProjectDir)..\..\..\src\scripts\batch\rename_output.bat" "$(OutDir)" "$(TargetName)" "CryptoAPI" "DELETE"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <!-- Win32 has no libgcrypt block above (it's x64-only), so it needs its own PostBuildEvent just
       for the product-named (CryptoAPI.*) copy step. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <PostBuildEvent>
      <Message>Renaming the project-named ($(TargetName).*) build output to the product-named (CryptoAPI.*) files</Message>
      <Command>call "$(ProjectDir)..\..\..\src\scripts\batch\rename_output.bat" "$(OutDir)" "$(TargetName)" "CryptoAPI" "DELETE"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
