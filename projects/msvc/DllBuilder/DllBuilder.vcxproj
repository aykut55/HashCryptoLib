  <!-- The built-in Clean target only removes files MSBuild itself produced (tracked via .tlog);
       it has no knowledge of the CryptoAPI.* files rename_output.bat copies into $(OutDir) as a
       PostBuildEvent, so Clean would otherwise leave them behind as stale orphans. -->
  <Target Name="RemoveRenamedOutputs" AfterTargets="Clean">
    <ItemGroup>
      <RenamedOutputsToClean Include="$(OutDir)CryptoAPI.dll;$(OutDir)CryptoAPI.lib;$(OutDir)CryptoAPI.exp;$(OutDir)CryptoAPI.pdb" />
    </ItemGroup>
    <Delete Files="@(RenamedOutputsToClean)" TreatErrorsAsWarnings="true" />
  </Target>
