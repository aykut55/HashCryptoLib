    <!-- sol2's usertype/overload registration is template-heavy; /bigobj avoids hitting the COFF
         section-count limit, same precedent as AppBuilder.vcxproj's own identical entry. -->
    <ClCompile Include="..\..\..\src\Scripts\LuaScript\LuaScriptEngineSol.cpp">
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- LuaBridge3's addConstructor/addFunction overload registration is template-heavy the same
         way sol2's is; /bigobj for the same reason. -->
    <ClCompile Include="..\..\..\src\Scripts\LuaScript\LuaScriptEngineLuaBridge.cpp">
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\luaBridge30\Distribution;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="..\..\..\src\Scripts\LuaScript\LuaScriptEngineLuaBridgeLegacy.cpp">
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\luaBridge210\Source;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <!-- ChaiScript's add()/fun()/constructor<>() registration is template-heavy the same way
         sol2's/LuaBridge's is; /bigobj for the same reason. -->
    <ClCompile Include="..\..\..\src\Scripts\ChaiScript\ChaiScriptEngine.cpp">
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- pybind11's py::class_/py::init<>()/py::enum_ registration is template-heavy the same way
         sol2's/LuaBridge's/ChaiScript's is; /bigobj for the same reason. Compiled on ALL 4
         configurations (Rules.md requires every configuration to build) but only does real work on
         x64 (see the ARCH_X64/ARCH_WIN64 guard at the top of PythonScriptEngine.cpp). Python/
         pybind11 include paths are added here rather than project-wide for the same reason
         AppBuilder.vcxproj's own identical entry documents (pybind11/Python.h must never be
         visible to any other translation unit). -->
    <ClCompile Include="..\..\..\src\Scripts\PythonScript\PythonScriptEngine.cpp">
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\pybind11310\include;$(ProjectDir)..\..\..\3rdParty\scripts\python312\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="Main.cpp" />
