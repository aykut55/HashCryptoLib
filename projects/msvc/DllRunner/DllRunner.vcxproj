  <PropertyGroup Label="UserMacros" />
  <!-- DllRunner loads CryptoAPI.dll by its file name at runtime. Visual Studio otherwise starts
       the debugger in $(ProjectDir), while both DllRunner.exe and CryptoAPI.dll are emitted to
       $(OutDir) (notably by All.sln). Keep Run/F5 aligned with command-line execution from the
       output directory so LoadLibrary can resolve CryptoAPI.dll and its runtime dependencies. -->
  <PropertyGroup>
    <LocalDebuggerCommand>$(TargetPath)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ForceSynchronousPDBWrites>true</ForceSynchronousPDBWrites>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- DllRunner needs src for CryptoApiDllLoader.h/CryptoApi.h's own type declarations
           (CCryptoApi, ErrorCode, ProviderKind, etc.); unlike AppBuilder/DllBuilder/LibBuilder it
           does not compile CCryptoApi/CPgpEngine/CPgpEngineWrapper's own concrete implementation,
           so it needs none of their 3rdParty crypto-provider include dirs (Botan/CryptoPP/OpenSSL/
           libgcrypt) or CRT/ProjectReference matching for THOSE; CryptoAPI.dll is loaded and its
           ICryptoApi/IPgpEngine/IPgpEngineWrapper exports resolved entirely at runtime via
           CCryptoApiDllLoader (LoadLibrary/GetProcAddress), not linked against at compile time.
           DllRunner DOES compile the 5 scripting engines (CLuaScriptEngineSol/LuaBridge/
           LuaBridgeLegacy/CChaiScriptEngine/CPythonScriptEngine) to prove they can drive a
           DLL-hosted ICryptoApi*/IPgpEngine*/IPgpEngineWrapper* via CScriptCryptoApiDll/
           CScriptPgpEngineDll/CScriptPgpEngineWrapperDll (see ScriptCryptoApiDll.h's own header
           comment); those DO need their own vendored dependencies (Lua/sol2/LuaBridge/
           ChaiScript/pybind11+Python) and static-CRT matching (Lua547.lib), wired in the dedicated
           blocks below, same pattern as AppBuilder.vcxproj's own scripting section. The DLL_RUNNER
           macro (see PreprocessorDefinitions below) is what tells each engine's own .cpp to skip
           registering CScriptCryptoApi/CScriptPgpEngine/CScriptPgpEngineWrapper (the LOCAL,
           CCryptoApi-owning facades) and register only the lightweight *Dll ones. -->
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Lua (3rdParty\scripts\lua547, built by Lua547.vcxproj) and sol2 (3rdParty\scripts\sol330,
       header-only): the Lua scripting engine's binding library. Same dedicated-block precedent
       AppBuilder.vcxproj's own identical comment documents. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\lua547\src;$(ProjectDir)..\..\..\3rdParty\scripts\sol330;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- ChaiScript (3rdParty\scripts\chaiscript610\include, header-only). LuaBridge3/LuaBridge 2.10's
       own include paths are NOT added here (both publish "LuaBridge/LuaBridge.h" at the same
       relative path, see AppBuilder.vcxproj's own comment); each gets its override on its own
       ClCompile item below instead. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\chaiscript610\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Lua547.lib (built by Lua547.vcxproj) is built with the static CRT (MultiThreadedDebug/
       MultiThreaded); match it here so DllRunner links against the same CRT. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- CPythonScriptEngine (see PythonScriptEngine.h/.cpp) embeds CPython via pybind11; x64 ONLY,
       same precedent as AppBuilder.vcxproj's own identical block/comment. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\python312\libs;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>python312.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Copying the Python runtime DLLs/stdlib next to the output executable</Message>
      <Command>xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\*.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\*.pyd" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\python312.zip" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>DLL_RUNNER;ARCH_X86;ARCH_WIN32;BUILD_DEBUG;WIN32;_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
