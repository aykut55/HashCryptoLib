  <ItemGroup>
    <!-- Builds cryptlib.lib automatically (if missing/stale) whenever AppBuilder is built, and
         links it in; the output folders under cryptopp890 are build artifacts and safe to delete,
         they are regenerated from this reference.
         CryptoPPModernProvider and 3rdParty\cryptoppmodern202691 remain on disk but are
         intentionally NOT wired in here: getting cryptoppmodern202691\cryptlib.vcxproj to resolve
         as a ProjectReference reliably during SOLUTION (.sln) builds hit an unresolved MSBuild
         AssignProjectConfiguration issue (it silently fails to resolve/link only in solution
         builds, while the identical setup works fine building AppBuilder.vcxproj standalone) that
         wasn't worth blocking on. -->
    <ProjectReference Include="..\..\..\3rdParty\cryptopp890\cryptlib.vcxproj">
      <Project>{c39f4b46-6e89-4074-902e-ca57073044d2}</Project>
    </ProjectReference>
    <!-- Builds lua547.lib automatically (if missing/stale) and links it in, same auto-linking
         pattern as cryptlib.vcxproj above. -->
    <ProjectReference Include="..\..\..\3rdParty\scripts\lua547\Lua547.vcxproj">
      <Project>{7f3e9a2c-4b1d-4e6a-9c8f-2d5b6a7e1f30}</Project>
    </ProjectReference>
    <!-- Makefile-type project (see 3rdParty\openssl402\openssl.vcxproj); this only orders the
         build so libcrypto.lib exists first. It does not auto-link like a normal ProjectReference
         (that's why AdditionalDependencies/AdditionalLibraryDirectories above list it explicitly). -->
    <ProjectReference Include="..\..\..\3rdParty\openssl402\openssl.vcxproj">
      <Project>{5e6a1e2d-8c3f-4d4a-9b1e-2f7a6c9d0e11}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
