  <!-- Lua (3rdParty\scripts\lua547, built by Lua547.vcxproj below) and sol2 (3rdParty\scripts\sol330,
       header-only, its own single/sol/{sol,config,forward}.hpp layout): the Lua scripting engine's
       binding library. Own dedicated block, kept separate from the shared include line above so this
       dependency can be isolated/rolled back on its own, matching how OpenSSL/libgcrypt are each
       wired in their own blocks. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\lua547\src;$(ProjectDir)..\..\..\3rdParty\scripts\sol330;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
