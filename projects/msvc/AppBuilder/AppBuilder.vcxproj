      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\luaBridge210\Source;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <!-- ChaiScript's add()/fun()/constructor<>() registration is template-heavy the same way
         sol2's/LuaBridge's is (arguably more so); /bigobj for the same reason. -->
    <ClCompile Include="..\..\..\src\Scripts\ChaiScript\ChaiScriptEngine.cpp">
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- pybind11's py::class_/py::init<>()/py::enum_ registration is template-heavy the same way
         sol2's/LuaBridge's/ChaiScript's is; /bigobj for the same reason. Compiled on ALL 4
         configurations (Rules.md requires every configuration to build) but only does real work on
         x64; see the ARCH_X64/ARCH_WIN64 guard at the top of PythonScriptEngine.cpp, same
         precedent as LibgcryptProvider.cpp's own x64-only guard. Python/pybind11 include paths are
         added here rather than in a project-wide ItemDefinitionGroup because pybind11/Python.h must
         never be visible to any OTHER translation unit (it also drags in Windows.h and redefines
         NO_ERROR/EncryptFile/DecryptFile the same way ChaiScript's own headers do; see that file's
         own top-of-file comment for the full reasoning). -->
    <ClCompile Include="..\..\..\src\Scripts\PythonScript\PythonScriptEngine.cpp">
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\pybind11310\include;$(ProjectDir)..\..\..\3rdParty\scripts\python312\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!-- Botan's amalgamation bakes the target architecture into the generated source (used for
         e.g. MSVC's 64-bit-only _umul128 intrinsic), so Win32 and x64 each need their own copy;
         $(Platform) picks the right one. -->
    <ClCompile Include="..\..\..\3rdParty\botan3130\$(Platform)\botan_all.cpp">
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
