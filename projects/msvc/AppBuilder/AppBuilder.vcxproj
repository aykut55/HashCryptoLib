  </ItemDefinitionGroup>
  <!-- LuaBridge3 (3rdParty\scripts\luaBridge30\Distribution\LuaBridge\LuaBridge.h, amalgamated) and
       classic LuaBridge 2.10 (3rdParty\scripts\luaBridge210\Source\LuaBridge\LuaBridge.h, plain
       header set) both publish a header at the SAME relative path "LuaBridge/LuaBridge.h": adding
       both directories to the project-wide include path here would make #include <LuaBridge/...>
       ambiguous (whichever directory happens to be searched first wins for BOTH engines, silently
       compiling one of them against the wrong library). Each engine's own AdditionalIncludeDirectories
       override below (on its ClCompile item) prepends only the ONE directory it actually needs. -->
  <!-- ChaiScript (3rdParty\scripts\chaiscript610\include, header-only): third scripting binding
       library, see CChaiScriptEngine. No separate interpreter runtime to build/link, pure C++,
       unlike Lua's lua547.lib. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\chaiscript610\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- cryptlib.lib is built with the static CRT (MultiThreadedDebug/MultiThreaded); match it here
       so the whole project links against the same CRT as the Crypto++ provider's dependency. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- OpenSSL's libcrypto.lib is built per-Platform/Configuration under openssl402\_libs (see
       openssl402\openssl.vcxproj and its build-scripts); enable-static-vcruntime was used when
       building it so its CRT matches ours. Static linking also needs these system libs per
       OpenSSL's NOTES-WINDOWS.md. -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\openssl402\_libs\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libcrypto.lib;ws2_32.lib;gdi32.lib;advapi32.lib;crypt32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- libcrypto.lib's PDB (ossl_static.pdb) isn't archived alongside it, so the linker warns
           LNK4099 for every OpenSSL object; harmless (no debug info for OpenSSL internals), so
           silence it rather than leave noise in the build log. -->
      <AdditionalOptions>/ignore:4099 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!-- libgcrypt (CLibgcryptProvider, PROVIDER_LIBGCRYPT) is x64 ONLY: the vendored bundle
       3rdParty\libgcryptbundle11241 ships an x64 DLL plus libgcrypt-20-msvc.lib, an MSVC-native
       COFF import library generated from that DLL's export table. (The bundle's own
       lib\libgcrypt-20.lib / lib\libgpg-error-0.lib are GNU-ar-format .dll.a files renamed to
       .lib, which link.exe cannot consume; do NOT reference those.) No Win32/x86 libgcrypt build
       exists, so nothing here is applied to the Win32 configurations; LibgcryptProvider.cpp compiles
       to an all-unsupported stub there (its ARCH_X64/ARCH_WIN64 guard), keeping all 4
       configurations buildable per Rules.md. libgpg-error-0.dll is a runtime dependency of
       libgcrypt-20.dll only (no code here calls gpg-error directly), so it is copied next to the
       executable but never linked. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libgcrypt-20-msvc.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- PostBuildEvent's <Command> is a single project property, not batched %()-style item
         metadata: a second ItemDefinitionGroup under the same 'x64' condition setting its own
         PostBuildEvent/Command would silently OVERWRITE this one rather than append to it (MSBuild
         property semantics, last one evaluated wins). CPythonScriptEngine's own runtime DLL/stdlib
         copy step (see the Python block below) is therefore appended into THIS SAME Command instead
         of living in its own ItemDefinitionGroup, even though its include/lib/link settings do live
         in their own dedicated block (AdditionalIncludeDirectories/AdditionalLibraryDirectories/
         AdditionalDependencies genuinely are %()-batched and merge safely across groups). -->
    <PostBuildEvent>
      <Message>Copying the libgcrypt and Python runtime DLLs/stdlib next to the output executable</Message>
      <Command>xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgcrypt-20.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\libgcryptbundle11241\bin\libgpg-error-0.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\*.dll" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\*.pyd" "$(OutDir)"
xcopy /Y /D /Q "$(ProjectDir)..\..\..\3rdParty\scripts\python312\bin\python312.zip" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <!-- CPythonScriptEngine (fourth scripting binding library, see PythonScriptEngine.h/.cpp) embeds
       CPython via pybind11; like libgcrypt, this is x64 ONLY: python.org's Windows embeddable
       package (the practical source for a manually-vendored DLL+stdlib, see
       3rdParty/PYTHON_EMBED.md for exactly how 3rdParty\scripts\python312 was assembled) ships amd64
       binaries only, no Win32/x86 build. No Win32/x86 configuration links this; PythonScriptEngine.cpp
       compiles to an all-unsupported stub there (its own ARCH_X64/ARCH_WIN64 guard), same precedent
       as LibgcryptProvider.cpp, keeping all 4 configurations buildable per Rules.md. The import
       library (3rdParty\scripts\python312\libs\python312.lib) was hand-generated from
       python312.dll's own export table via dumpbin+lib.exe; python.org's embeddable package does
       not ship one; see 3rdParty/PYTHON_EMBED.md. -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)..\..\..\3rdParty\scripts\python312\libs;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>python312.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
