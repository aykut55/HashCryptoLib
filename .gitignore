# OpenSSL vendor tree (3rdParty/openssl402): only Configure/Configurations/crypto/ssl/providers/
# include/apps are needed to build libcrypto/libssl. demos/test/fuzz/external-vendor dirs are
# large, irrelevant to the build, and bundle many sample/test private keys that trip GitHub's
# secret scanner.
3rdParty/openssl402/demos/
3rdParty/openssl402/test/
3rdParty/openssl402/fuzz/
3rdParty/openssl402/wycheproof/
3rdParty/openssl402/tlsfuzzer/
3rdParty/openssl402/tlslite-ng/
3rdParty/openssl402/python-ecdsa/
3rdParty/openssl402/oqs-provider/
3rdParty/openssl402/pkcs11-provider/
3rdParty/openssl402/cloudflare-quiche/
3rdParty/openssl402/VMS/
3rdParty/openssl402/doc/
3rdParty/openssl402/**/*.pem
3rdParty/openssl402/configdata.pm
3rdParty/openssl402/makefile
3rdParty/openssl402/_libs/
3rdParty/openssl402/_install/
3rdParty/openssl402/_build_*/

# Lua/LuaBridge/LuaBridge3 vendor trees (3rdParty/scripts): same "trim the upstream repo's own
# test/doc/CI scaffolding" policy as openssl402 above. Only src/ (lua547), Source/ (luaBridge210),
# and Distribution/ (luaBridge30, the amalgamated header actually included) are needed to build.
3rdParty/scripts/lua547/doc/
3rdParty/scripts/luaBridge210/Tests/
3rdParty/scripts/luaBridge210/.github/
3rdParty/scripts/luaBridge210/third_party/
3rdParty/scripts/luaBridge30/Tests/
3rdParty/scripts/luaBridge30/Benchmarks/
3rdParty/scripts/luaBridge30/Images/
3rdParty/scripts/luaBridge30/.github/
3rdParty/scripts/luaBridge30/ThirdParty/

# ChaiScript vendor tree (3rdParty/scripts/chaiscript610): same policy as above. Only include/ is
# needed to build (header-only); unittests/samples/src/contrib/cmake/performance_tests/static_libs
# are the upstream repo's own test suite, CLI interpreter, and build scaffolding, not needed here.
3rdParty/scripts/chaiscript610/unittests/
3rdParty/scripts/chaiscript610/samples/
3rdParty/scripts/chaiscript610/src/
3rdParty/scripts/chaiscript610/contrib/
3rdParty/scripts/chaiscript610/cmake/
3rdParty/scripts/chaiscript610/performance_tests/
3rdParty/scripts/chaiscript610/static_libs/
