  <PropertyGroup Label="UserMacros" />
  <!-- No libssh2_config.h needed: src/libssh2_setup.h self-configures on plain _WIN32 (its own
       "#elif defined(_WIN32)" hand-crafted branch, used whenever HAVE_CONFIG_H is NOT defined),
       verified by reading that header directly rather than assuming the usual autotools/CMake
       flow applies here. Only LIBSSH2_OPENSSL needs to be defined, so src/crypto.c's own
       "#include openssl.c" branch selects the OpenSSL backend (reusing this repo's existing
       3rdParty/openssl402, already built/used by Certificates/CmsService/TimestampService,
       so no new crypto dependency is introduced). Building a StaticLibrary (no LIBSSH2_EXPORTS/
       _WINDLL) means include/libssh2.h's own LIBSSH2_API macro resolves to empty automatically. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ForceSynchronousPDBWrites>true</ForceSynchronousPDBWrites>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)src;$(ProjectDir)..\openssl402\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>LIBSSH2_OPENSSL;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Static CRT so the resulting Ssh2.lib links cleanly into AppBuilder/LibRunner/etc. (which
       force MultiThreadedDebug/MultiThreaded everywhere to match Crypto++/OpenSSL). -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
