  <!-- OpenSSL's own Configure+nmake build system is not MSBuild-based, so this Makefile-type
       project just shells out to the matching build-scripts\build_*.bat, which run Configure once
       (skipped on later builds if a makefile already exists for that config) and then
       "nmake build_libs". Outputs land under _libs\$(Platform)\$(Configuration)\, which is what
       AppBuilder links against (see AppBuilder.vcxproj's AdditionalDependencies). -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <NMakeBuildCommandLine>call "$(ProjectDir)build-scripts\build_x64_debug.bat"</NMakeBuildCommandLine>
    <NMakeOutput>$(ProjectDir)_libs\x64\Debug\libcrypto.lib</NMakeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <NMakeBuildCommandLine>call "$(ProjectDir)build-scripts\build_x64_release.bat"</NMakeBuildCommandLine>
    <NMakeOutput>$(ProjectDir)_libs\x64\Release\libcrypto.lib</NMakeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <NMakeBuildCommandLine>call "$(ProjectDir)build-scripts\build_win32_debug.bat"</NMakeBuildCommandLine>
    <NMakeOutput>$(ProjectDir)_libs\Win32\Debug\libcrypto.lib</NMakeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <NMakeBuildCommandLine>call "$(ProjectDir)build-scripts\build_win32_release.bat"</NMakeBuildCommandLine>
    <NMakeOutput>$(ProjectDir)_libs\Win32\Release\libcrypto.lib</NMakeOutput>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
